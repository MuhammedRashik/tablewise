          }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/verify-otp",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\",\n  \"otp\": \"PASTE_OTP_FROM_CONSOLE\",\n  \"name\": \"Rahul Kumar\"\n}"
            }
          }
        },

        {
          "name": "01.7 Get Me (Owner)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }]
          }
        },

        {
          "name": "01.8 Get Me (Customer)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }]
          }
