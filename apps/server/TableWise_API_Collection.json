            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@spicegarden.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        },

        {
          "name": "01.10 Invalid Phone Format (expect 422)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/send-otp",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"phone\": \"12345\"\n}"
            }
          }
        }

      ]
    },

    {
      "name": "02 — RESTAURANT MODULE",
      "item": [

        {
          "name": "02.1 Create Restaurant",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.restaurant) {",
                "  pm.collectionVariables.set('restaurantId', res.data.restaurant._id);",
                "  console.log('restaurantId saved:', res.data.restaurant._id);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/restaurants",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Spice Garden\",\n  \"phone\": \"9876543210\",\n  \"cuisine\": \"South Indian\",\n  \"address\": {\n    \"street\": \"12 Anna Salai\",\n    \"city\": \"Chennai\",\n    \"state\": \"Tamil Nadu\",\n    \"pincode\": \"600001\"\n  }\n}"
            }
          }
        },

        {
          "name": "02.2 Get My Restaurant (Owner)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }]
          }
        },

        {
          "name": "02.3 Get Public Restaurant Info (No Auth)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/public/{{restaurantId}}"
          }
        },

        {
          "name": "02.4 Get QR Code",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/qr",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }]
          }
        },

        {
          "name": "02.5 Update Restaurant Info",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Spice Garden Premium\",\n  \"cuisine\": \"South Indian & Tandoor\"\n}"
            }
          }
        },

        {
          "name": "02.6 Update Settings",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/settings",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settings\": {\n    \"totalTables\": 12,\n    \"autoBumpMinutes\": 8,\n    \"avgTurnoverMinutes\": 40,\n    \"maxQueueSize\": 50\n  }\n}"
            }
          }
        },

        {
          "name": "02.7 Close Queue",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/queue/toggle",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isOpen\": false\n}"
            }
          }
        },

        {
          "name": "02.8 Reopen Queue",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/queue/toggle",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isOpen\": true\n}"
            }
          }
        },

        {
          "name": "02.9 Regenerate QR Code",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/qr/regenerate",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }]
          }
        },

        {
          "name": "02.10 Create Restaurant Again (expect 409)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/restaurants",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate Restaurant\"\n}"
            }
          }
        }

      ]
    },

    {
      "name": "03 — TABLE MODULE",
      "item": [

        {
          "name": "03.1 Bulk Create Tables",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.tables && res.data.tables.length >= 3) {",
                "  pm.collectionVariables.set('tableId1', res.data.tables[0]._id);",
                "  pm.collectionVariables.set('tableId2', res.data.tables[1]._id);",
                "  pm.collectionVariables.set('tableId3', res.data.tables[2]._id);",
                "  console.log('tableIds saved');",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/tables/bulk",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tables\": [\n    { \"tableNumber\": \"T1\", \"capacity\": 2, \"location\": \"Window Left\" },\n    { \"tableNumber\": \"T2\", \"capacity\": 2, \"location\": \"Window Right\" },\n    { \"tableNumber\": \"T3\", \"capacity\": 4, \"location\": \"Centre\" },\n    { \"tableNumber\": \"T4\", \"capacity\": 4, \"location\": \"Centre\" },\n    { \"tableNumber\": \"T5\", \"capacity\": 6, \"location\": \"Private Room\" },\n    { \"tableNumber\": \"T6\", \"capacity\": 6, \"location\": \"Private Room\" },\n    { \"tableNumber\": \"T7\", \"capacity\": 2, \"location\": \"Outdoor\" },\n    { \"tableNumber\": \"T8\", \"capacity\": 4, \"location\": \"Outdoor\" }\n  ]\n}"
            }
          }
        },

        {
          "name": "03.2 Create Single Table",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/tables",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": \"VIP-1\",\n  \"capacity\": 8,\n  \"location\": \"VIP Section\"\n}"
            }
          }
        },

        {
          "name": "03.3 Get All Tables",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/tables",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }]
          }
        },

        {
          "name": "03.4 Get Available Tables Only",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/tables?status=available"
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }]
          }
        },

        {
          "name": "03.5 Mark Table as Cleaning",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/tables/{{tableId3}}/status",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"cleaning\"\n}"
            }
          }
        },

        {
          "name": "03.6 Mark Table as Available",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/tables/{{tableId3}}/status",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"available\"\n}"
            }
          }
        },

        {
          "name": "03.7 Invalid Transition (expect 400)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/tables/{{tableId1}}/status",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"occupied\"\n}"
            }
          }
        },

        {
          "name": "03.8 Duplicate Table Number (expect 409)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/tables",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": \"T1\",\n  \"capacity\": 2\n}"
            }
          }
        }

      ]
    },

    {
      "name": "04 — QUEUE MODULE",
      "item": [

        {
          "name": "04.1 Customer Joins Queue",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.entry) {",
                "  pm.collectionVariables.set('queueEntryId', res.data.entry._id);",
                "  console.log('queueEntryId saved:', res.data.entry._id);",
                "  console.log('Status:', res.data.entry.status);",
                "  console.log('Position:', res.data.entry.position);",
                "  console.log('EWT:', res.data.entry.estimatedWaitMinutes, 'min');",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/queue/{{restaurantId}}/join",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partySize\": 2,\n  \"notes\": \"Window seat preferred\"\n}"
            }
          }
        },

        {
          "name": "04.2 Get My Queue Position",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/queue/entry/{{queueEntryId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }]
          }
        },

        {
          "name": "04.3 Staff Views Full Queue",
          "request": {
            "method": "GET",
