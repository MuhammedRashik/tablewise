{
  "info": {
    "name": "TableWise - Complete API Collection",
    "description": "Full backend test suite. Run in order top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:8000/api" },
    { "key": "ownerToken",    "value": "" },
    { "key": "staffToken",    "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "restaurantId",  "value": "" },
    { "key": "tableId1",      "value": "" },
    { "key": "tableId2",      "value": "" },
    { "key": "tableId3",      "value": "" },
    { "key": "queueEntryId",  "value": "" },
    { "key": "queueEntryId2", "value": "" },
    { "key": "menuItemId1",   "value": "" },
    { "key": "menuItemId2",   "value": "" },
    { "key": "menuItemId3",   "value": "" },
    { "key": "orderId",       "value": "" },
    { "key": "orderItemId",   "value": "" }
  ],
  "item": [

    {
      "name": "01 — AUTH MODULE",
      "item": [

        {
          "name": "01.1 Register Owner",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.accessToken) {",
                "  pm.collectionVariables.set('ownerToken', res.data.accessToken);",
                "  console.log('ownerToken saved');",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/staff/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Suresh Menon\",\n  \"email\": \"owner@spicegarden.com\",\n  \"password\": \"test@1234\",\n  \"role\": \"owner\"\n}"
            }
          }
        },

        {
          "name": "01.2 Register Staff",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.accessToken) {",
                "  pm.collectionVariables.set('staffToken', res.data.accessToken);",
                "  console.log('staffToken saved');",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/staff/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya Staff\",\n  \"email\": \"staff@spicegarden.com\",\n  \"password\": \"test@1234\",\n  \"role\": \"staff\"\n}"
            }
          }
        },

        {
          "name": "01.3 Owner Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.accessToken) {",
                "  pm.collectionVariables.set('ownerToken', res.data.accessToken);",
                "  console.log('ownerToken refreshed');",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/staff/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@spicegarden.com\",\n  \"password\": \"test@1234\"\n}"
            }
          }
        },

        {
          "name": "01.4 Staff Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.accessToken) {",
                "  pm.collectionVariables.set('staffToken', res.data.accessToken);",
                "  console.log('staffToken refreshed');",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/staff/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@spicegarden.com\",\n  \"password\": \"test@1234\"\n}"
            }
          }
        },

        {
          "name": "01.5 Send OTP (Customer)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/send-otp",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Kumar\",\n  \"phone\": \"9876543210\"\n}"
            }
          }
        },

        {
          "name": "01.6 Verify OTP → Customer Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.accessToken) {",
                "  pm.collectionVariables.set('customerToken', res.data.accessToken);",
                "  console.log('customerToken saved');",
                "}"
              ]
