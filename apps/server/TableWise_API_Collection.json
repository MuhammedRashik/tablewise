    {
      "name": "05 — MENU MODULE",
      "item": [

        {
          "name": "05.1 Bulk Create Menu Items",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data && res.data.items && res.data.items.length >= 3) {",
                "  pm.collectionVariables.set('menuItemId1', res.data.items[0]._id);",
                "  pm.collectionVariables.set('menuItemId2', res.data.items[1]._id);",
                "  pm.collectionVariables.set('menuItemId3', res.data.items[2]._id);",
                "  console.log('menuItemIds saved');",
                "}"
              ]
            }
          }],
          "request": {
